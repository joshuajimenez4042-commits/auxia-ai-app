# Copia este archivo como .env y agrega tu configuración.
# Nunca publiques este archivo ni pongas la clave en el navegador.
OPENAI_API_KEY=pega_aqui_tu_clave
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1/chat/completions
PORT=5000

# Solo esta cuenta obtiene permisos de moderador.
MODERATOR_EMAIL=tu-correo@example.com
MODERATOR_PASSWORD=elige-una-clave-segura
FLASK_SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
